---
interface Props {
  action?: string;
  ariaLabel?: string;
  name?: string;
  pagefindBase?: string;
  placeholder?: string;
}

const {
  action = '/docs/',
  ariaLabel = 'Search',
  name = 'q',
  pagefindBase = '/pagefind/',
  placeholder = 'Search',
} = Astro.props;
const developmentWarning = import.meta.env.DEV
  ? 'Search is only available in production builds. \nTry building and previewing the site to test it out locally.'
  : undefined;
---

<csk-navbar-search
  data-pagefind-base={pagefindBase}
  data-development-search={developmentWarning ? '' : undefined}
>
  <button type="button" data-open-search aria-label={ariaLabel} aria-keyshortcuts="Control+K">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m16 16 4 4"></path>
    </svg>
    <span aria-hidden="true">{placeholder}</span>
    <kbd><span data-platform-key>Ctrl</span> K</kbd>
  </button>

  <dialog aria-label={ariaLabel}>
    <div class="csk-navbar-search__frame">
      <form action={action} method="get" role="search">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <input
          type="search"
          name={name}
          placeholder={placeholder}
          aria-label={ariaLabel}
          autocomplete="off"
        />
      </form>
      <ul data-search-results aria-live="polite" hidden></ul>
      {developmentWarning && <div class="csk-navbar-search__development" dir="ltr"><p>{developmentWarning}</p></div>}
    </div>
  </dialog>
</csk-navbar-search>

<script is:inline>
  (() => {
    if (customElements.get('csk-navbar-search')) return;

    class CachixNavbarSearch extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready !== undefined) return;
        this.dataset.ready = '';

        const openButton = this.querySelector('[data-open-search]');
        const platformKey = this.querySelector('[data-platform-key]');
        const dialog = this.querySelector('dialog');
        const frame = this.querySelector('.csk-navbar-search__frame');
        const form = this.querySelector('form');
        const input = this.querySelector('input');
        const results = this.querySelector('[data-search-results]');
        const development = this.hasAttribute('data-development-search');
        if (!openButton || !dialog || !frame || !form || !input || !results) return;

        if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
          platformKey.textContent = '⌘';
          openButton.setAttribute('aria-keyshortcuts', 'Meta+K');
        }

        let enginePromise;
        let searchId = 0;

        const loadEngine = () => {
          if (!enginePromise) {
            const value = this.dataset.pagefindBase || '/pagefind/';
            const base = new URL(value.endsWith('/') ? value : `${value}/`, location.origin);
            enginePromise = import(new URL('pagefind.js', base).href)
              .then(async (engine) => {
                await engine.init();
                return engine;
              })
              .catch(() => undefined);
          }
          return enginePromise;
        };

        const clearResults = () => {
          results.replaceChildren();
          results.hidden = true;
        };

        const renderResults = async (query) => {
          const id = ++searchId;
          if (!query.trim()) {
            clearResults();
            return;
          }

          const engine = await loadEngine();
          if (!engine || id !== searchId) return;
          try {
            const response = await engine.search(query);
            const entries = await Promise.all(response.results.slice(0, 8).map((result) => result.data()));
            if (id !== searchId) return;

            const items = entries.map((entry) => {
              const item = document.createElement('li');
              const link = document.createElement('a');
              const title = document.createElement('strong');
              link.href = entry.url;
              title.textContent = entry.meta.title || entry.url;
              link.append(title);
              item.append(link);
              return item;
            });
            results.replaceChildren(...items);
            results.hidden = items.length === 0;
          } catch {
            if (id === searchId) clearResults();
          }
        };

        const openSearch = () => {
          if (!dialog.open) dialog.showModal();
          document.body.toggleAttribute('data-search-modal-open', true);
          if (!development) {
            input.focus();
            input.select();
          }
        };

        const closeSearch = () => {
          if (dialog.open) dialog.close();
        };

        openButton.addEventListener('click', openSearch);
        input.addEventListener('input', () => renderResults(input.value));
        input.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowDown') return;
          const firstResult = results.querySelector('a');
          if (!firstResult) return;
          event.preventDefault();
          firstResult.focus();
        });
        form.addEventListener('submit', (event) => {
          const firstResult = results.querySelector('a');
          if (!firstResult) return;
          event.preventDefault();
          firstResult.click();
        });
        dialog.addEventListener('click', (event) => {
          if (!frame.contains(event.target)) closeSearch();
        });
        dialog.addEventListener('close', () => {
          document.body.toggleAttribute('data-search-modal-open', false);
          clearResults();
          openButton.focus();
        });
        results.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) closeSearch();
        });
        results.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
          const links = [...results.querySelectorAll('a')];
          const current = links.indexOf(document.activeElement);
          if (current < 0) return;
          event.preventDefault();
          if (event.key === 'ArrowUp' && current === 0) {
            input.focus();
            return;
          }
          const offset = event.key === 'ArrowDown' ? 1 : -1;
          links[(current + offset + links.length) % links.length].focus();
        });
        window.addEventListener('keydown', (event) => {
          if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== 'k') return;
          event.preventDefault();
          dialog.open ? closeSearch() : openSearch();
        });
      }
    }

    customElements.define('csk-navbar-search', CachixNavbarSearch);
  })();
</script>

<style>
  csk-navbar-search {
    display: block;
    width: 100%;
  }

  button,
  input {
    font: inherit;
  }

  button[data-open-search] {
    align-items: center;
    background: var(--csk-navbar-search-background, var(--csk-navbar-background, transparent));
    border: 1px solid var(--csk-navbar-border, currentColor);
    border-radius: var(--csk-navbar-search-radius, var(--csk-corner-radius, 0.5rem));
    color: var(--csk-navbar-muted, var(--csk-navbar-color, currentColor));
    cursor: pointer;
    display: flex;
    gap: 0.5rem;
    height: 2.5rem;
    padding: 0 0.5rem 0 0.75rem;
    transition: border-color var(--csk-interaction-duration) ease, color var(--csk-interaction-duration) ease;
    width: 100%;
  }

  @media (min-width: 50rem) {
    button[data-open-search] {
      font-size: 0.875rem;
    }
  }

  button[data-open-search]:hover,
  button[data-open-search]:focus-visible {
    border-color: var(--csk-navbar-accent, currentColor);
    color: var(--csk-navbar-color, currentColor);
    outline: none;
  }

  svg {
    fill: none;
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-width: 1.75;
  }

  button[data-open-search] kbd {
    background: color-mix(in srgb, currentColor 8%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: var(--csk-navbar-search-key-radius, var(--csk-corner-radius, 0.25rem));
    font-family: var(--csk-navbar-font, ui-monospace, monospace);
    font-size: 0.68rem;
    line-height: 1;
    margin-inline-start: auto;
    padding: 0.28rem 0.4rem;
  }

  dialog {
    background: var(--csk-navbar-search-modal-background, var(--csk-navbar-background, white));
    border: 1px solid var(--csk-navbar-border, currentColor);
    border-radius: var(--csk-navbar-search-radius, var(--csk-corner-radius, 0.5rem));
    box-shadow: 0 1.5rem 4rem color-mix(in srgb, black 28%, transparent);
    color: var(--csk-navbar-color, currentColor);
    margin: 4rem auto auto;
    max-height: calc(100% - 8rem);
    max-width: 40rem;
    min-height: 15rem;
    padding: 0;
    width: calc(100% - 2rem);
  }

  dialog[open] {
    display: flex;
  }

  dialog::backdrop {
    backdrop-filter: blur(0.25rem);
    background: color-mix(in srgb, black 58%, transparent);
  }

  .csk-navbar-search__frame {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    overflow: auto;
    padding: 1.5rem;
  }

  csk-navbar-search[data-development-search] .csk-navbar-search__frame {
    justify-content: center;
  }

  csk-navbar-search[data-development-search] form,
  csk-navbar-search[data-development-search] ul {
    display: none;
  }

  .csk-navbar-search__development {
    margin: auto;
    text-align: center;
    white-space: pre-line;
  }

  form {
    align-items: center;
    border: 1px solid var(--csk-navbar-border, currentColor);
    border-radius: var(--csk-navbar-search-radius, var(--csk-corner-radius, 0.5rem));
    display: flex;
    flex: 0 0 auto;
    min-height: 3.5rem;
    position: relative;
  }

  form:focus-within {
    border-color: var(--csk-navbar-accent, currentColor);
  }

  form svg {
    left: 1rem;
    pointer-events: none;
    position: absolute;
  }

  input {
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    height: 3.5rem;
    min-width: 0;
    outline: 0;
    padding: 0 1rem 0 2.75rem;
    width: 100%;
  }

  input::placeholder {
    color: var(--csk-navbar-muted, currentColor);
    opacity: 0.72;
  }

  ul {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul[hidden] {
    display: none;
  }

  :global(csk-navbar-search [data-search-results] li a) {
    border: 1px solid var(--csk-navbar-border, currentColor);
    border-radius: var(--csk-navbar-search-radius, var(--csk-corner-radius, 0.5rem));
    color: inherit;
    display: block;
    padding: 0.875rem 1rem;
    text-decoration: none;
    transition: border-color var(--csk-interaction-duration) ease;
  }

  :global(csk-navbar-search [data-search-results] li a:hover),
  :global(csk-navbar-search [data-search-results] li a:focus-visible) {
    border-color: var(--csk-navbar-accent, currentColor);
    outline: none;
  }

  :global(body[data-search-modal-open]) {
    overflow: hidden;
  }

  @media not all and (min-width: 50rem) {
    csk-navbar-search {
      margin-inline-start: auto;
      max-width: 2.75rem;
    }

    button[data-open-search] {
      background: transparent;
      border-color: transparent;
      font-size: 1.25rem;
      height: 2.75rem;
      justify-content: center;
      padding: 0;
      width: 2.75rem;
    }

    button[data-open-search] > span,
    button[data-open-search] kbd {
      display: none;
    }

    dialog {
      margin-block-start: 1rem;
      max-height: calc(100% - 2rem);
      min-height: min(15rem, calc(100% - 2rem));
    }

    .csk-navbar-search__frame {
      padding: 1rem;
    }
  }
</style>
