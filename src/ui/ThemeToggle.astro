---
interface Props {
  label: string;
  storageKey?: string;
}

const {
  label,
  storageKey = 'starlight-theme',
} = Astro.props;
---

<csk-theme-toggle data-storage-key={storageKey}>
  <button type="button" aria-label={label}>
    <svg class="csk-theme-toggle__sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
    </svg>
    <svg class="csk-theme-toggle__moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
    </svg>
  </button>
</csk-theme-toggle>

<script>
  import { defineThemeToggle } from './theme.js';

  defineThemeToggle();
</script>
