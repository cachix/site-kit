---
import '@cachix/site-kit/ui/styles.css';
import Button from '@cachix/site-kit/ui/Button.astro';
import FlowArrow from '@cachix/site-kit/ui/FlowArrow.astro';
import FlowArrowPair from '@cachix/site-kit/ui/FlowArrowPair.astro';
import LatestPostBanner from '@cachix/site-kit/ui/LatestPostBanner.astro';
import Navbar from '@cachix/site-kit/ui/Navbar.astro';
import NavbarActions from '@cachix/site-kit/ui/NavbarActions.astro';
import TerminalFrame from '@cachix/site-kit/ui/TerminalFrame.astro';
import VersionCompatibility from '@cachix/site-kit/ui/VersionCompatibility.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Site Kit components</title>
  </head>
  <body>
    <Navbar>
      <a slot="brand" href="/">Site Kit</a>
      <form slot="search" action="/" role="search">
        <input type="search" name="q" placeholder="Search" aria-label="Search" />
      </form>
      <NavbarActions
        repositoryHref="https://github.com/cachix/site-kit"
        metadataEndpoint={false}
        version={false}
        blog={{ label: 'Blog', href: '/blog/' }}
        docs={{ label: 'Docs', href: '/components/' }}
      />
    </Navbar>
    <main>
      <Button href="/" variant="primary">Read the docs</Button>
      <FlowArrow label="derivations" decorative={false} ariaLabel="Derivations flow" />
      <FlowArrowPair decorative={false} ariaLabel="Derivations and logs flow" />
      <LatestPostBanner
        href="/blog/prototype/"
        title="Site Kit prototype"
        date="Aug 26, 2026"
      />
      <TerminalFrame title="terminal" status="ready"><code>site-kit</code></TerminalFrame>
      <VersionCompatibility version="1.2" />
      <VersionCompatibility version="1.3" kind="changed" label="Upgrade note">
        <p>The default behavior changed.</p>
      </VersionCompatibility>
    </main>
  </body>
</html>

<style>
  :global(body) {
    background: #0b1017;
    margin: 0;
  }

  :global(.csk-navbar) {
    --csk-navbar-background: #111923;
    --csk-navbar-border: #263342;
    --csk-navbar-color: #e8edf2;
  }

  :global(.csk-navbar input) {
    background: #0b1017;
    border: 1px solid #263342;
    border-radius: 0.5rem;
    color: #e8edf2;
    height: 2.5rem;
    padding-inline: 0.75rem;
  }

  main {
    --csk-accent: #f1a342;
    --csk-accent-strong: #5dc3d8;
    --csk-line: #263342;
    --csk-surface: #111923;
    --csk-surface-muted: #17212d;
    --csk-text: #e8edf2;
    align-items: start;
    display: grid;
    gap: 2.5rem;
    margin: 3rem;
    max-width: 32rem;
  }

  :global(.csk-flow-pair) {
    --csk-flow-pair-length: 8rem;
  }
</style>
